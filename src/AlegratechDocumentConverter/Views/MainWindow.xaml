<Window x:Class="AlegratechDocumentConverter.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:AlegratechDocumentConverter.Converters"
        xmlns:cmd="clr-namespace:AlegratechDocumentConverter.Commands"
        xmlns:vm="clr-namespace:AlegratechDocumentConverter.ViewModels"
        xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
        mc:Ignorable="d"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="Alegratech Document Converter"
        Width="1180" Height="780"
        MinWidth="980" MinHeight="640"
        WindowStartupLocation="Manual"
        ResizeMode="CanResizeWithGrip"
        Background="{StaticResource LightGrayBrush}"
        FontFamily="{StaticResource PrimaryFontFamily}"
        Icon="pack://application:,,,/Resources/app.ico"
        Closing="OnWindowClosing"
        Loaded="OnWindowLoaded">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <conv:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
        <conv:CountToVisibilityConverter x:Key="CountToVisibilityConverter"/>
        <conv:StatusToBrushConverter x:Key="StatusToBrushConverter"/>
        <conv:IconKeyToPathConverter x:Key="IconKeyToPathConverter"/>
        <conv:DurationToTextConverter x:Key="DurationToTextConverter"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ============================== ENCABEZADO ============================== -->
        <Border Grid.Row="0" Background="{StaticResource WhiteBrush}" Padding="28,20"
                BorderBrush="{StaticResource BorderGrayBrush}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <svgc:SvgViewbox Source="pack://application:,,,/Resources/Icons/logo.svg"
                                  Width="42" Height="42" Margin="0,0,16,0" VerticalAlignment="Center"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Alegratech Document Converter" Style="{StaticResource TitleTextStyle}"/>
                    <TextBlock Text="Convierte cualquier documento a Markdown utilizando IA." Style="{StaticResource SubtitleTextStyle}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ============================== CONTENIDO PRINCIPAL ============================== -->
        <Grid Grid.Row="1" Margin="24,20,24,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <!-- Columna izquierda: Drag and Drop + Lista de archivos -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="14"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Zona Drag & Drop -->
                <Border Grid.Row="0" Style="{StaticResource DropZoneBorderStyle}" MinHeight="150"
                        cmd:DropBehavior.DropCommand="{Binding AddDroppedFilesCommand}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
                        <svgc:SvgViewbox Source="pack://application:,,,/Resources/Icons/folder.svg"
                                          Width="40" Height="40" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <TextBlock Text="Arrastra tus archivos aquí" Style="{StaticResource HeadingTextStyle}" HorizontalAlignment="Center"/>
                        <TextBlock HorizontalAlignment="Center" Style="{StaticResource CaptionTextStyle}" Margin="0,4,0,14" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="520"
                                   Text="PDF, DOC, DOCX, PPT, PPTX, XLS, XLSX, CSV, TXT, HTML, ZIP, JPEG, PNG, TIFF, BMP, GIF, WEBP, MP3, WAV, M4A"/>
                        <Button Content="Seleccionar archivos" Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding SelectFilesCommand}" HorizontalAlignment="Center" MinWidth="180"/>
                    </StackPanel>
                </Border>

                <!-- Lista de archivos seleccionados -->
                <Border Grid.Row="2" Background="{StaticResource WhiteBrush}" BorderBrush="{StaticResource BorderGrayBrush}"
                        BorderThickness="1" CornerRadius="6">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="14,12,14,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Files.Count, StringFormat='Archivos seleccionados ({0})'}"
                                       Style="{StaticResource HeadingTextStyle}"/>
                            <Button Grid.Column="1" Content="Limpiar lista" Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding ClearFilesCommand}" Padding="10,4"/>
                        </Grid>

                        <ListView Grid.Row="1" ItemsSource="{Binding Files}" Style="{StaticResource FluentListViewStyle}"
                                  ItemContainerStyle="{StaticResource FluentListViewItemStyle}" Margin="1,0,1,1"
                                  BorderThickness="0,1,0,0">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="" Width="42">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <svgc:SvgViewbox Source="{Binding IconKey, Converter={StaticResource IconKeyToPathConverter}}"
                                                                  Width="22" Height="22"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Nombre" Width="260" DisplayMemberBinding="{Binding FileName}"/>
                                    <GridViewColumn Header="Peso" Width="90" DisplayMemberBinding="{Binding FileSizeFormatted}"/>
                                    <GridViewColumn Header="Tipo" Width="140" DisplayMemberBinding="{Binding TypeLabel}"/>
                                    <GridViewColumn Header="Estado" Width="150">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding StatusLabel}" FontWeight="SemiBold"
                                                           Foreground="{Binding Status, Converter={StaticResource StatusToBrushConverter}}"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="" Width="40">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="&#x2715;" Style="{StaticResource IconButtonStyle}"
                                                        Command="{Binding DataContext.RemoveFileCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                        CommandParameter="{Binding}" Foreground="{StaticResource DarkGrayBrush}"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>

                        <TextBlock Grid.Row="1" Text="Aún no has añadido archivos. Arrástralos arriba o usa &quot;Seleccionar archivos&quot;."
                                   Style="{StaticResource CaptionTextStyle}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding Files.Count, Converter={StaticResource CountToVisibilityConverter}, ConverterParameter=Invert}"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- Columna derecha: Opciones, salida, convertir, progreso -->
            <Border Grid.Column="2" Background="{StaticResource WhiteBrush}" BorderBrush="{StaticResource BorderGrayBrush}"
                    BorderThickness="1" CornerRadius="6">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18,16">
                    <StackPanel>
                        <TextBlock Text="Opciones" Style="{StaticResource HeadingTextStyle}" Margin="0,0,0,10"/>
                        <CheckBox Content="Mantener imágenes" Style="{StaticResource FluentCheckBoxStyle}" IsChecked="{Binding KeepImages}"/>
                        <CheckBox Content="Crear carpeta por documento" Style="{StaticResource FluentCheckBoxStyle}" IsChecked="{Binding CreateFolderPerDocument}"/>
                        <CheckBox Content="Abrir carpeta al finalizar" Style="{StaticResource FluentCheckBoxStyle}" IsChecked="{Binding OpenFolderWhenFinished}"/>
                        <CheckBox Content="Sobrescribir archivos existentes" Style="{StaticResource FluentCheckBoxStyle}" IsChecked="{Binding OverwriteExistingFiles}"/>
                        <CheckBox Content="Mostrar log detallado" Style="{StaticResource FluentCheckBoxStyle}" IsChecked="{Binding ShowDetailedLog}"/>
                        <CheckBox Content="Extraer metadatos" Style="{StaticResource FluentCheckBoxStyle}" IsChecked="{Binding ExtractMetadata}"/>
                        <CheckBox Content="Copiar Markdown al portapapeles" Style="{StaticResource FluentCheckBoxStyle}" IsChecked="{Binding CopyMarkdownToClipboard}"/>

                        <Separator Margin="0,6,0,16" Background="{StaticResource BorderGrayBrush}"/>

                        <TextBlock Text="Directorio de salida" Style="{StaticResource HeadingTextStyle}" Margin="0,0,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Style="{StaticResource FluentTextBoxStyle}" Text="{Binding OutputDirectory, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Grid.Column="2" Content="Examinar" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding BrowseOutputDirectoryCommand}"/>
                        </Grid>

                        <Separator Margin="0,18,0,16" Background="{StaticResource BorderGrayBrush}"/>

                        <Button Content="CONVERTIR" Style="{StaticResource ConvertButtonStyle}"
                                Command="{Binding ConvertCommand}"
                                Visibility="{Binding IsConverting, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"/>
                        <Button Content="CANCELAR" Style="{StaticResource ConvertButtonStyle}" Background="{StaticResource ErrorBrush}"
                                Command="{Binding CancelConversionCommand}"
                                Visibility="{Binding IsConverting, Converter={StaticResource BoolToVisibilityConverter}}"/>

                        <StackPanel Margin="0,18,0,0">
                            <ProgressBar Style="{StaticResource FluentProgressBarStyle}" Value="{Binding ProgressPercentage, Mode=OneWay}" Minimum="0" Maximum="100"/>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{StaticResource CaptionTextStyle}"
                                           Text="{Binding ProgressPercentage, StringFormat={}{0:0}%}"/>
                                <TextBlock Grid.Column="1" Style="{StaticResource CaptionTextStyle}" Margin="0,0,14,0"
                                           Text="{Binding RemainingTimeText, StringFormat='Restante: {0}'}"/>
                                <TextBlock Grid.Column="2" Style="{StaticResource CaptionTextStyle}"
                                           Text="{Binding SpeedText, StringFormat='Velocidad: {0}'}"/>
                            </Grid>
                            <TextBlock Style="{StaticResource CaptionTextStyle}" Margin="0,8,0,0" TextWrapping="Wrap"
                                       Text="{Binding StatusSummaryText}"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ============================== LOG INFERIOR ============================== -->
        <Border Grid.Row="2" Background="{StaticResource WhiteBrush}" BorderBrush="{StaticResource BorderGrayBrush}"
                BorderThickness="0,1,0,0" Padding="24,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="140"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Registro de actividad" Style="{StaticResource HeadingTextStyle}" Margin="0,0,0,6"/>
                <ListBox x:Name="LogListBox" Grid.Row="1" ItemsSource="{Binding LogLines}"
                         Background="{StaticResource LighterGrayBrush}" BorderBrush="{StaticResource BorderGrayBrush}" BorderThickness="1"
                         FontFamily="Consolas" FontSize="11.5" ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
            </Grid>
        </Border>
    </Grid>
</Window>
